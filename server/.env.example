# ==========================================
# Quaders - Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated for multiple production domains)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Authentication
# Secret key used for signing JWT tokens (generate a secure 64+ char random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# PostgreSQL Database (e.g. Railway, Neon, Supabase, AWS RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/quaders"

# Redis Cache (e.g. Railway, Upstash, AWS ElastiCache)
# Format: redis://default:PASSWORD@HOST:PORT
REDIS_URL="redis://localhost:6379"

# ==========================================
# SMTP / Email Configuration (Nodemailer)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@quaders.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Quaders School Management <notifications@quaders.com>"

# ==========================================
# Cloudinary / File Storage (Optional Global Fallback)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=quaders_preset

# ==========================================
# Payment Webhooks
# ==========================================
PAYMENT_WEBHOOK_SECRET=quaders_webhook_secret_production

# ==========================================
# WhatsApp Cloud API (Optional Global Fallback)
# ==========================================
WHATSAPP_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# ==========================================
# AI Assistant & OpenRouter Configuration
# ==========================================
# OpenRouter API Key (Server-only, NEVER exposed to client)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI Model (e.g. meta-llama/llama-3.3-70b-instruct, google/gemini-2.5-flash, anthropic/claude-3.5-sonnet)
AI_MODEL=meta-llama/llama-3.3-70b-instruct

# AI Request Timeout in milliseconds
AI_REQUEST_TIMEOUT_MS=35000

# Daily AI Request Quotas per Plan Tier
AI_LIMIT_FREE=1
AI_LIMIT_BASIC=5
AI_LIMIT_STANDARD=10
AI_LIMIT_ENTERPRISE=30

