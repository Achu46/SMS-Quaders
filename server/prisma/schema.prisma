// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// Multi-tenant core
model School {
  id                      String          @id @default(uuid())
  name                    String
  status                  SchoolStatus    @default(PENDING)
  setupCompleted          Boolean         @default(false)
  academicSetupCompleted  Boolean         @default(false)
  address                 String?
  board                   String?         // e.g. "CBSE", "ICSE", "State Board", "Matric"
  phone                   String?
  logoUrl                 String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  users                   User[]
  roles                   Role[]
  staffRoles              StaffRole[]
  academicYears           AcademicYear[]
  classes                 Class[]
  sections                Section[]
  subjects                Subject[]
  classAssignments        ClassAssignment[]
  students                Student[]
  parents                 Parent[]
  attendances             Attendance[]
  leaves                  LeaveRequest[]
  feeStructures           FeeStructure[]
  invoices                Invoice[]
  documents               SchoolDocument[]
  aiUsages                AiUsage[]
  aiAuditLogs             AiAuditLog[]
  aiConversations         AiConversation[]
  supportTickets          SupportTicket[]
  modules                 SchoolModule[]
  examinations            Examination[]
  assessments             Assessment[]
  assessmentGrades        AssessmentGrade[]
  reportCardTemplates     ReportCardTemplate[]
  reportCards             ReportCard[]
  staffInvites            StaffInvite[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  PARENT

  @@map("Role")
}

enum StaffStatus {
  INVITED
  ACTIVE
  INACTIVE
}

model Role {
  id                 String           @id @default(uuid())
  collegeId          String           // scoped by collegeId (tenant ID)
  school             School           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  permissionsVersion Int              @default(1)
  permissions        RolePermission[]
  users              User[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([collegeId, name])
  @@index([collegeId])
  @@map("roles")
}

model RolePermission {
  id          String   @id @default(uuid())
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleKey   String
  canCreate   Boolean  @default(false)
  canRead     Boolean  @default(false)
  canUpdate   Boolean  @default(false)
  canDelete   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roleId, moduleKey])
  @@index([roleId])
  @@map("role_permissions")
}

model StaffRole {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name         String   // e.g. "Principal", "Class Teacher", "Accountant"
  isSystemRole Boolean  @default(false)
  permissions  Json     // Map/Array of permissions: { "attendance": { "read": true, "create": true, ... } }
  
  users        User[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model User {
  id               String            @id @default(uuid())
  schoolId         String?
  school           School?           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  email            String            @unique
  password         String?
  name             String
  phone            String?
  employeeId       String?
  status           StaffStatus       @default(INVITED)
  role             UserRole          @default(PARENT)
  
  roleId           String?
  customRole       Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  staffRoleId      String?
  staffRole        StaffRole?        @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  
  classAssignments ClassAssignment[]
  passwordResetTokens PasswordResetToken[]
  assignedTickets  SupportTicket[]   @relation("AssignedTickets")
  parents          Parent[]
  assessmentsTaught Assessment[]
  gradeOverrides   AssessmentGrade[] @relation("GradeOverrides")
  staffInvites     StaffInvite[]     @relation("StaffInvites")
  createdInvites   StaffInvite[]     @relation("CreatedInvites")

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([roleId])
}

model StaffInvite {
  id          String    @id @default(uuid())
  collegeId   String
  school      School    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  staffId     String
  staff       User      @relation("StaffInvites", fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("CreatedInvites", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([collegeId])
  @@index([staffId])
  @@index([tokenHash])
  @@map("staff_invites")
}

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name      String   // e.g. "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  classes   Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id             String            @id @default(uuid())
  schoolId       String
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  academicYearId String?
  academicYear   AcademicYear?     @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  
  name           String            // e.g. "Grade 10"
  sections       Section[]
  students       Student[]
  subjects       Subject[]
  assignments    ClassAssignment[]
  fees           FeeStructure[]
  attendances    Attendance[]
  examinations   Examination[]
  assessments    Assessment[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([schoolId])
  @@index([academicYearId])
}

model Section {
  id          String            @id @default(uuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  classId     String
  class       Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  name        String            // e.g. "A", "B"
  students    Student[]
  assignments ClassAssignment[]
  examinations Examination[]
  assessments Assessment[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([classId, name])
  @@index([schoolId])
  @@index([classId])
}

model Subject {
  id          String            @id @default(uuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  classId     String?
  class       Class?            @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  name        String            // e.g. "Mathematics", "Science"
  code        String?           // e.g. "MATH-10"
  
  assignments ClassAssignment[]
  assessments Assessment[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([schoolId])
  @@index([classId])
}

model ClassAssignment {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  staffId        String
  staff          User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  sectionId      String?
  section        Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  
  isClassTeacher Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId])
  @@index([staffId])
  @@index([classId])
  @@index([sectionId])
}

model Parent {
  id        String          @id @default(uuid())
  schoolId  String
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  relation  String?         // e.g. "Father", "Mother", "Guardian"
  
  students  ParentStudent[]

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([schoolId])
  @@index([userId])
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Student {
  id          String            @id @default(uuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  classId     String
  class       Class             @relation(fields: [classId], references: [id], onDelete: Restrict)
  
  sectionId   String?
  section     Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  
  firstName   String
  lastName    String
  admissionNo String
  rollNo      String?
  dob         DateTime?
  gender      String?
  status      String            @default("ACTIVE") // ACTIVE, INACTIVE, ALUMNI

  parents     ParentStudent[]
  attendances AttendanceEntry[]
  invoices    Invoice[]
  leaves      LeaveRequest[]
  assessmentGrades AssessmentGrade[]
  reportCards ReportCard[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([admissionNo])
}

model Attendance {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  // Storing the date string to query efficiently like "2026-08-27_FN" or we can store Date and Session
  date      String   
  session   String   // "FN" or "AN"
  markedBy  String   // userId

  entries   AttendanceEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, classId, date, session])
  @@index([schoolId])
  @@index([classId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model AttendanceEntry {
  id           String     @id @default(uuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  status       AttendanceStatus

  @@unique([attendanceId, studentId])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id            String      @id @default(uuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  applicantId   String      // Could map to User if teacher, or Student if parent
  applicantName String
  applicantRole String      // "teacher" or "parent"
  
  studentId     String?     // If applied by parent
  student       Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  leaveType     String
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        LeaveStatus @default(PENDING)
  
  supportingDoc String?     // URL of the attachment

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([applicantId])
}

model FeeStructure {
  id        String    @id @default(uuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  name      String
  amount    Float
  dueDate   DateTime

  invoices  Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
  @@index([classId])
}

enum InvoiceStatus {
  PENDING
  PAID
}

model Invoice {
  id           String        @id @default(uuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  feeId        String
  feeStructure FeeStructure  @relation(fields: [feeId], references: [id], onDelete: Cascade)
  
  status       InvoiceStatus @default(PENDING)
  amount       Float
  dueDate      DateTime
  paidAt       DateTime?
  transactionId String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([feeId])
  @@index([status])
}

model SchoolDocument {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  collection  String   // e.g. "notices", "timetables", "inventory", "teachers", "settings"
  data        Json     // Flexible JSON payload

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, collection])
}

model AiUsage {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan         String   @default("FREE")
  usageDate    String   // Format: "YYYY-MM-DD"
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, usageDate])
  @@index([schoolId])
}

model AiAuditLog {
  id               String   @id @default(uuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId           String
  model            String
  toolsUsed        Json     @default("[]")
  status           String   // "SUCCESS", "FAILED", "QUOTA_EXCEEDED"
  latencyMs        Int?
  tokensPrompt     Int?
  tokensCompletion Int?
  errorCategory    String?
  createdAt        DateTime @default(now())

  @@index([schoolId, createdAt])
}

model AiConversation {
  id        String   @id @default(uuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  title     String   @default("New Chat")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([schoolId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String?        @unique
  schoolId     String?
  school       School?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  creatorId    String?
  creatorName  String
  creatorEmail String
  
  subject      String
  description  String
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  
  assignedToId String?
  assignedTo   User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages     SupportTicketMessage[]
  history      SupportTicketHistory[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([schoolId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
}

model SupportTicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  senderId    String?
  senderName  String
  senderRole  String
  message     String
  attachments Json          @default("[]")

  createdAt   DateTime      @default(now())

  @@index([ticketId])
}

model SupportTicketHistory {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  actorId     String?
  actorName   String
  action      String
  oldValue    String?
  newValue    String?
  
  createdAt   DateTime      @default(now())

  @@index([ticketId])
}

model Module {
  id          String         @id
  name        String
  category    String         @default("CORE")
  description String?
  icon        String?
  isCore      Boolean        @default(false)
  actions     Json           @default("[\"VIEW\"]")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  schoolModules SchoolModule[]
}

model SchoolModule {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isEnabled Boolean  @default(true)
  settings  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, moduleId])
  @@index([schoolId])
  @@index([moduleId])
}

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String   @default("Super Administrator")
  phone     String?
  role      String   @default("SUPER_ADMIN")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("superadmin")
}

// ==========================================
// Exams, Results & Report Card Module
// ==========================================

enum ExaminationStatus {
  DRAFT
  PUBLISHED
  FINALIZED
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  LOCKED
}

enum ReportCardStatus {
  PUBLISHED
  ARCHIVED
}

model Examination {
  id           String            @id @default(uuid())
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name         String            // e.g. "Midterm Examination 2024-25"
  examType     String            @default("Term") // "Final", "Term", "Periodic", "Class Test"
  academicYear String            // e.g. "2024-2025"
  term         String?           // e.g. "Term 1", "Term 2"
  startDate    DateTime
  endDate      DateTime
  status       ExaminationStatus @default(DRAFT)
  
  classId      String?
  class        Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  sectionId    String?
  section      Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  
  customData   Json?
  
  assessments  Assessment[]
  reportCards  ReportCard[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([schoolId])
  @@index([academicYear])
  @@index([status])
  @@index([classId])
  @@map("examinations")
}

model Assessment {
  id            String           @id @default(uuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  examinationId String?
  examination   Examination?     @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  
  classId       String
  class         Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId     String?
  section       Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subjectId     String
  subject       Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  teacherId     String?
  teacher       User?            @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  
  title         String           // e.g. "Mathematics Theory"
  totalMarks    Float            @default(100)
  passingMarks  Float            @default(40)
  weightage     Float            @default(100)
  examDate      DateTime?
  status        AssessmentStatus @default(PENDING)
  components    Json?            // defined subcomponents e.g. [{"name":"PT", "maxMarks":20}, {"name":"Theory", "maxMarks":80}]
  
  grades        AssessmentGrade[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([schoolId])
  @@index([examinationId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@map("assessments")
}

model AssessmentGrade {
  id             String     @id @default(uuid())
  schoolId       String
  school         School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  marksObtained  Float      @default(0)
  isAbsent       Boolean    @default(false)
  isExempt       Boolean    @default(false)
  grade          String?
  remarks        Json?      // sub-component breakdown e.g. {"components": {"PT": 18, "Theory": 74}, "notes": "Good"}
  
  overrideReason String?
  overriddenById String?
  overriddenBy   User?      @relation("GradeOverrides", fields: [overriddenById], references: [id], onDelete: SetNull)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([schoolId])
  @@index([assessmentId])
  @@index([studentId])
  @@map("assessment_grades")
}

model ReportCardTemplate {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name            String   @default("Standard Report Card")
  type            String   @default("CBSE") // "DEFAULT", "CBSE", "CUSTOM"
  branding        Json?    // { "primaryColor": "#1e40af", "showLogo": true, "schoolMotto": "..." }
  headerConfig    Json?    // { "title": "ANNUAL PROGRESS REPORT", "affiliationText": "Affiliated to CBSE..." }
  signatureBlocks Json?    // { "classTeacher": true, "principal": true, "parent": true }
  gradingScale    Json?    // [{"min": 91, "max": 100, "grade": "A1"}, ...]
  customColumns   Json?    // component layout configuration
  rawHtml         String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, type])
  @@index([schoolId])
  @@map("report_card_templates")
}

model ReportCard {
  id                 String           @id @default(uuid())
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  examinationId      String
  examination        Examination      @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  
  academicYear       String
  term               String?
  
  marksBreakdown     Json             // array of subjects with component scores, maxMarks, marksObtained, letterGrade
  totalMarksObtained Float
  totalMaxMarks      Float
  percentage         Float
  overallGrade       String
  attendanceStats    Json?            // { "totalSessions": 120, "present": 114, "absent": 6, "percentage": 95.0 }
  
  status             ReportCardStatus @default(PUBLISHED)
  publishedAt        DateTime         @default(now())

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([schoolId, studentId, examinationId])
  @@index([schoolId])
  @@index([studentId])
  @@index([examinationId])
  @@map("report_cards")
}


